# === Gemini API Key (required for browser → Gemini Live connection) ===
GEMINI_API_KEY=your-gemini-api-key-here

# === Google AI Studio (quickstart — free, no GCP needed) ===
# Agent works with vision only, sessions/memory are non-persistent
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key-here

# === Vertex AI (unlocks all features) ===
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# === Model Selection ===
# GEMINI_MODEL=gemini-2.5-flash

# === Document AI (grounding layer) ===
# Create Invoice Parser at: https://console.cloud.google.com/ai/document-ai
# DOCAI_PROCESSOR_ID=your-processor-id
# DOCAI_LOCATION=us

# === Vertex AI Search (semantic search over past invoices) ===
# Run: python scripts/setup_vertex_search.py
# VERTEX_SEARCH_DATA_STORE_ID=invoicescan-invoices
# VERTEX_SEARCH_ENGINE_ID=invoicescan-engine

# === Google Sheets (auto-log scanned invoices) ===
# Create a blank sheet, share it with your service account email, paste the ID here.
# Sheet ID is the long string in the URL: docs.google.com/spreadsheets/d/{THIS_PART}/edit
# SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# Optional: path to service account key JSON (otherwise uses ADC)
# GOOGLE_SHEETS_KEY_FILE=path/to/service-account.json

# === Agent Engine (sessions + memory — both use the same engine) ===
# When set, sessions and memory are persistent via Vertex AI.
# Without it, both fall back to in-memory (lost on restart).
# AGENT_ENGINE_ID=your-reasoning-engine-id
